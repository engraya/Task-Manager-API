# Template for .env — copy to `.env` and fill in values:
#   cp .env.example .env
# This file IS committed; it documents which variables the app needs
# without containing any real secrets.

# development | production | test        (default: development)
NODE_ENV=development

# TCP port the HTTP server listens on    (default: 3000)
PORT=3000

# Log verbosity: fatal|error|warn|info|debug|trace|silent
# (default: info in production, debug in development)
LOG_LEVEL=debug

# Reverse-proxy hops to trust for X-Forwarded-* (real client IP/protocol).
# 0 = trust none (default). Behind ONE load balancer, set 1. Never set higher
# than the real number of proxies — it lets clients spoof their IP.
TRUST_PROXY=0

# MongoDB connection string — REQUIRED. CONTAINS YOUR DATABASE PASSWORD:
# the real value lives only in .env, never in this file, never in git.
# Get it from Atlas: Cluster -> Connect -> Drivers -> Node.js, then insert
# the database name (/taskmanager) after the host, before the `?`.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/taskmanager

# Secret that signs JWTs — REQUIRED, min 32 chars, unique per environment.
# Anyone holding this value can forge logins. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<generate-a-random-64-hex-string>

# OPTIONAL — only for running integration tests. Integration tests use
# mongodb-memory-server, which normally auto-downloads a mongod binary to its
# cache on first run. If that download is unreliable on your machine, download
# the binary once and point this at the extracted mongod(.exe):
#   MONGOMS_SYSTEM_BINARY=C:\path\to\mongod.exe
# Leave unset to let mongodb-memory-server manage the binary itself.
