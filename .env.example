# Template for .env — copy to `.env` and fill in values:
#   cp .env.example .env
# This file IS committed; it documents which variables the app needs
# without containing any real secrets.

# development | production | test        (default: development)
NODE_ENV=development

# TCP port the HTTP server listens on    (default: 3000)
PORT=3000

# Path of the JSON file tasks are persisted to (default: data/tasks.json).
# Temporary storage mechanism (Phase 8) — replaced by MongoDB in Phase 9.
DATA_FILE=data/tasks.json

# MongoDB connection string (Phase 9). CONTAINS YOUR DATABASE PASSWORD —
# real value lives only in .env, never in this file, never in git.
# Get it from Atlas: Cluster -> Connect -> Drivers -> Node.js, then append
# the database name (/taskmanager) before the query string.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/taskmanager?retryWrites=true&w=majority
