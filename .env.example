# Template for .env — copy to `.env` and fill in values:
#   cp .env.example .env
# This file IS committed; it documents which variables the app needs
# without containing any real secrets.

# development | production | test        (default: development)
NODE_ENV=development

# TCP port the HTTP server listens on    (default: 3000)
PORT=3000

# MongoDB connection string — REQUIRED. CONTAINS YOUR DATABASE PASSWORD:
# the real value lives only in .env, never in this file, never in git.
# Get it from Atlas: Cluster -> Connect -> Drivers -> Node.js, then insert
# the database name (/taskmanager) after the host, before the `?`.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/taskmanager
