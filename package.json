{
  "name": "taskmanager-api",
  "version": "0.1.0",
  "description": "A production-style REST API for managing tasks, built with Node.js and Express.",
  "main": "dist/server.js",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "seed": "tsx scripts/seed.ts",
    "migrate:orphans": "tsx scripts/migrate-orphan-tasks.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run integration",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "rest-api",
    "express",
    "nodejs",
    "task-manager"
  ],
  "author": "Ahmad",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^3.2.7",
    "mongodb-memory-server": "^11.2.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.4",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  }
}
