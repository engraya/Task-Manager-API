# Dependencies — reinstallable from package.json + package-lock.json; never commit
node_modules/

# Build output — generated from src/ by `npm run build`; never commit
dist/

# Runtime data — the app's stored state is not source code
data/

# Environment variables — contain secrets (DB passwords, JWT keys); never commit
.env
.env.local
.env.*.local

# Logs — runtime output, not source code
logs/
*.log
npm-debug.log*

# OS-generated files
.DS_Store
Thumbs.db

# Editor/IDE settings — personal preference, not project code
.idea/

# Test coverage output — generated, not source
coverage/
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat
.gitignore
